# ~/.dircolors — thème vert, généré à partir de « dircolors -p »
# et adapté pour ce projet
COLOR tty
TERM xterm-256color
TERM screen-256color

# --- Types génériques ---
NORMAL 00
FILE 00
DIR 01;32
LINK 04;36
ORPHAN 01;31
MISSING 00;41;33
EXEC 01;37

# --- Archives et compressés ---
.zip 00;33
.tar 00;33
.gz 00;33
.7z 00;33
.rar 00;33

# --- Scripts et code ---
.sh 01;32
.py 00;32
.js 00;32
.json 00;32

# --- Images ---
.jpg 00;35
.png 00;35
.gif 00;35

# --- Documents ---
.md 00;36
.txt 00
.pdf 00;36